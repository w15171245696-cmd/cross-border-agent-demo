+    columns: ['用户名', '部门', '角色', '最近登录', '状态'],
+    rows: [
+      ['admin', '管理中心', '管理员', '2026-10-10', '启用'],
+      ['sales.demo', '销售部', '销售专员', '2026-10-09', '启用'],
